APP_ENV=development

# 可选。配置后，AUTO负责场景选择；显式场景也会使用模型提取结构化参数。
# 未配置或模型暂时不可用时，总控会降级到确定性路由和同一套参数检查。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.7-flash
# 反思使用独立模型客户端，默认关闭思考模式以支持严格结构化输出。
REFLECTION_MODEL=qwen3.7-flash
REFLECTION_ENABLE_THINKING=false

# Task1真实资产检索服务根地址；Adapter调用 /api/v1/task1/search-by-text。
ASSET_SERVICE_URL=http://127.0.0.1:8001
# text2sql-mvp真实FastAPI根地址；Adapter调用 /api/v1/query，不依赖Streamlit前端。
SQL_SERVICE_URL=http://127.0.0.1:8002
LINEAGE_SERVICE_URL=http://127.0.0.1:8003
PROFESSIONAL_SERVICE_TOKEN=
REQUEST_TIMEOUT_SECONDS=60
MEMORY_MAX_MESSAGES=12
MEMORY_MAX_CHARS=6000
TASK_DATABASE_PATH=./data/asset_agent.db
DATABASE_URL=postgresql+psycopg://asset_agent_user:change_me@127.0.0.1:5432/asset_agent

# 可选：LangSmith 可观测性。默认关闭；启用时只在本地 .env 中填写真实密钥。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-asset-supervisor
