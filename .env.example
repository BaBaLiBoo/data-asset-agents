EMBEDDING_API_KEY=replace-with-your-local-key
EMBEDDING_BASE_URL=https://your-openai-compatible-service.example/v1
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_DIMENSION=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_API_KEY_HEADER=Authorization
EMBEDDING_API_KEY_PREFIX=Bearer
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# Natural-language retrieval defaults. A DEV-generated
# data/retrieval_thresholds.json takes precedence when present.
TEXT_SEARCH_VECTOR_WEIGHT=0.80
TEXT_SEARCH_KEYWORD_WEIGHT=0.20
TEXT_SEARCH_DEFAULT_TOP_K=5
TEXT_SEARCH_MAX_TOP_K=20
TEXT_SEARCH_MIN_SCORE=0.60
SQL_SEARCH_EMBEDDING_WEIGHT=0.50
SQL_SEARCH_KEYWORD_WEIGHT=0.10
SQL_SEARCH_LOGIC_WEIGHT=0.30
SQL_SEARCH_IDENTIFIER_WEIGHT=0.10
SQL_SEARCH_MIN_SCORE=0.60
