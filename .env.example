APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=minibank
POSTGRES_USER=minibank
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=minibank
DATABASE_USER=minibank
DATABASE_CONNECT_TIMEOUT=5
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200

# mock works without any API key. Set to live to enable the provider adapter.
LLM_MODE=mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=2

EMBEDDING_PROVIDER=aliyun
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024

ONTOLOGY_PATH=ontology/retail_banking
HISTORICAL_SQL_PATH=data/historical_sql/examples.json
API_BASE_URL=http://localhost:8000
WEB_API_BASE_URL=http://api:8000
DEMO_MODE=true
DEVELOPER_MODE=false
DEMO_REQUIRE_LIVE_AI=true
DEMO_ONTOLOGY_VERSION_NAME=quality-v2-gold-independent
DEMO_ONTOLOGY_DISPLAY_NAME=MiniBank 正式业务本体 v1.0
EVALUATION_BENCHMARK_PATH=data/benchmark/text2sql_v1.json
EVALUATION_LIVE_CONCURRENCY=1
EVALUATION_SMOKE_CONCURRENCY=2
